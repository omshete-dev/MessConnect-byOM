<?xml version="1.0"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="firstpage.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>

  <connectionStrings>
    <add name="MessConnect" connectionString="Data Source=localhost;Initial Catalog=Mess_connect;Integrated Security=True" providerName="System.Data.SqlClient" />
    <add name="LegacyLogin" connectionString="Data Source=localhost;Initial Catalog=loginpage;Integrated Security=True" providerName="System.Data.SqlClient" />
    <add name="AddressDemo" connectionString="Data Source=localhost;Initial Catalog=Address;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>

	<system.web>
		<compilation targetFramework="4.8" debug="true"/>
		<pages controlRenderingCompatibilityVersion="4.0"/>
	</system.web>
	
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>